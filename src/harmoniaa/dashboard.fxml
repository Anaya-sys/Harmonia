                                              -fx-border-color: rgba(86,74,181,0.3);
                                              -fx-border-radius: 8;
                                              -fx-text-fill: #E9E9ED;
                                              -fx-prompt-text-fill: #8F8AA8;
                                              -fx-font-size: 13px;"/>
                        </VBox>

                        <!-- Presupuesto -->
                        <VBox spacing="6">
                            <Label text="Presupuesto (USD)"
                                   style="-fx-font-size: 11px;
                                          -fx-text-fill: #8F8AA8;"/>
