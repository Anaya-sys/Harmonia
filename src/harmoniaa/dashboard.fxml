<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.GaussianBlur?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>

<!--
╔══════════════════════════════════════════════════════════╗
║              HARMONIA  –  DASHBOARD FXML                 ║
║  Layout: sidebar fijo 220px + área central dinámica     ║
║  Paleta: #151221 bg · #1E1A2E cards · #564AB5 accent     ║
║          #BC7F15 gold · #E9E9ED text · #8F8AA8 muted    ║
║  Secciones: Inicio · Catálogo · Carrito · Pedidos · Perfil║
║  Para agregar imágenes: busca comentarios "TODO: IMG"    ║
╚══════════════════════════════════════════════════════════╝
-->

<BorderPane
    fx:controller="harmoniaa.DashboardController"
    prefHeight="720.0" prefWidth="1200.0"
    minHeight="600.0" minWidth="900.0"
    style="-fx-background-color: #151221;"
    xmlns="http://javafx.com/javafx/26"
    xmlns:fx="http://javafx.com/fxml/1">

    <!-- ══════════════════════════════════════════════════════
         SIDEBAR  ·  220px fija  ·  fondo #1E1A2E
         ══════════════════════════════════════════════════════ -->
    <left>
        <VBox prefWidth="220.0"
              style="-fx-background-color: #1E1A2E;
                     -fx-border-color: rgba(86,74,181,0.25);
                     -fx-border-width: 0 1 0 0;">

            <!-- ── LOGO ── -->
            <HBox alignment="CENTER_LEFT" spacing="12"
                  style="-fx-padding: 26 18 20 18;">
                <!-- Icono de nota musical / Glow circle -->
                <StackPane prefWidth="38.0" prefHeight="38.0">
                    <Circle radius="19.0"
                            fill="#564AB5" opacity="0.18"/>
                    <Label text="♩"
                           style="-fx-font-size: 22px;
                                  -fx-text-fill: #BC7F15;
                                  -fx-font-weight: bold;"/>
                </StackPane>
                <VBox spacing="1">
                    <Label text="Harmonia"
                           style="-fx-font-size: 17px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #E9E9ED;"/>
                    <Label text="tu tienda de música"
                           style="-fx-font-size: 9px;
                                  -fx-text-fill: #8F8AA8;"/>
                </VBox>
            </HBox>

            <Separator style="-fx-background-color: rgba(86,74,181,0.2);
                              -fx-border-color: transparent;"/>

            <!-- ── NAV ITEMS ──
                 Activo: #564AB5 bg, blanco, bold
                 Inactivo: transparente, #8F8AA8
                 Estilos gestionados desde DashboardController -->
            <VBox fx:id="navContainer" spacing="4"
                  style="-fx-padding: 14 10 14 10;"
                  VBox.vgrow="ALWAYS">

                <Button fx:id="navBtnInicio"
                        text="  🏠   Inicio"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        prefHeight="40.0"
                        mnemonicParsing="false"
                        onAction="#navegarInicio"
                        style="-fx-background-color: #564AB5;
                               -fx-background-radius: 10;
                               -fx-text-fill: white;
                               -fx-font-size: 13px;
                               -fx-font-weight: bold;
                               -fx-cursor: hand;
                               -fx-padding: 0 12 0 14;"/>

                <Button fx:id="navBtnCatalogo"
                        text="  🎸   Catálogo"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        prefHeight="40.0"
                        mnemonicParsing="false"
                        onAction="#navegarCatalogo"
                        style="-fx-background-color: transparent;
                               -fx-background-radius: 10;
                               -fx-text-fill: #8F8AA8;
                               -fx-font-size: 13px;
                               -fx-cursor: hand;
                               -fx-padding: 0 12 0 14;"/>

                <Button fx:id="navBtnCarrito"
                        text="  🛒   Carrito"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        prefHeight="40.0"
                        mnemonicParsing="false"
                        onAction="#navegarCarrito"
                        style="-fx-background-color: transparent;
                               -fx-background-radius: 10;
                               -fx-text-fill: #8F8AA8;
                               -fx-font-size: 13px;
                               -fx-cursor: hand;
                               -fx-padding: 0 12 0 14;"/>

                <Button fx:id="navBtnPedidos"
                        text="  📦   Pedidos"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        prefHeight="40.0"
                        mnemonicParsing="false"
                        onAction="#navegarPedidos"
                        style="-fx-background-color: transparent;
                               -fx-background-radius: 10;
                               -fx-text-fill: #8F8AA8;
                               -fx-font-size: 13px;
                               -fx-cursor: hand;
                               -fx-padding: 0 12 0 14;"/>

                <Button fx:id="navBtnPerfil"
                        text="  👤   Perfil"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        prefHeight="40.0"
                        mnemonicParsing="false"
                        onAction="#navegarPerfil"
                        style="-fx-background-color: transparent;
                               -fx-background-radius: 10;
                               -fx-text-fill: #8F8AA8;
                               -fx-font-size: 13px;
                               -fx-cursor: hand;
                               -fx-padding: 0 12 0 14;"/>
            </VBox>

            <!-- ── INFO USUARIO (bottom sidebar) ── -->
            <HBox alignment="CENTER_LEFT" spacing="10"
                  style="-fx-padding: 12 10 16 12;
                         -fx-border-color: rgba(86,74,181,0.2);
                         -fx-border-width: 1 0 0 0;">

                <!-- Avatar circular – Inicial del usuario -->
                <StackPane prefWidth="36.0" prefHeight="36.0">
                    <Circle radius="18.0"
                            fill="#272239"
                            stroke="#564AB5" strokeWidth="1.5"/>
                    <Label fx:id="lblAvatarInitial" text="?"
                           style="-fx-font-size: 14px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #564AB5;"/>
                </StackPane>

                <VBox spacing="1" HBox.hgrow="ALWAYS">
                    <Label fx:id="lblSidebarNombre" text="Usuario"
                           style="-fx-font-size: 12px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #E9E9ED;"/>
                    <Label fx:id="lblSidebarRol" text="ROL"
                           style="-fx-font-size: 9px;
                                  -fx-text-fill: #BC7F15;
                                  -fx-font-weight: bold;"/>
                </VBox>

                <!-- Botón logout -->
                <Button fx:id="btnLogout"
                        text="⇠"
                        prefWidth="30.0" prefHeight="30.0"
                        mnemonicParsing="false"
                        onAction="#handleLogout"
                        style="-fx-background-color: rgba(255,107,107,0.12);
                               -fx-background-radius: 8;
                               -fx-text-fill: #FF6B6B;
                               -fx-font-size: 14px;
                               -fx-cursor: hand;
                               -fx-border-color: rgba(255,107,107,0.2);
                               -fx-border-radius: 8;"/>
            </HBox>
        </VBox>
    </left>

    <!-- ══════════════════════════════════════════════════════
         ÁREA DE CONTENIDO  ·  StackPane dinámico
         El controlador muestra/oculta cada pane según la nav
         ══════════════════════════════════════════════════════ -->
    <center>
        <StackPane fx:id="contentArea"
                   style="-fx-background-color: #151221;">

            <!-- ─────────────────────────────────────────────
                 PANE: INICIO
                 ───────────────────────────────────────────── -->
            <ScrollPane fx:id="paneInicio"
                        fitToWidth="true"
                        hbarPolicy="NEVER"
                        style="-fx-background-color: transparent;
                               -fx-background: transparent;
                               -fx-border-color: transparent;">
                <VBox spacing="26"
                      style="-fx-padding: 28 32 36 32;
                             -fx-background-color: #151221;">

                    <!-- TOP BAR: saludo + buscador -->
                    <HBox alignment="CENTER_LEFT" spacing="16">
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label fx:id="lblGreeting"
                                   text="Bienvenido 👋"
                                   style="-fx-font-size: 22px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #E9E9ED;"/>
                            <Label text="Descubre lo mejor en instrumentos y accesorios"
                                   style="-fx-font-size: 12px;
                                          -fx-text-fill: #8F8AA8;"/>
                        </VBox>
                        <TextField fx:id="txtBuscar"
                                   promptText="🔍  Buscar productos..."
                                   prefWidth="240.0" prefHeight="38.0"
                                   style="-fx-background-color: #1E1A2E;
                                          -fx-background-radius: 20;
                                          -fx-border-color: rgba(86,74,181,0.3);
                                          -fx-border-radius: 20;
                                          -fx-text-fill: #E9E9ED;
                                          -fx-prompt-text-fill: #8F8AA8;
                                          -fx-font-size: 12px;
                                          -fx-padding: 0 18 0 18;"/>
                    </HBox>

                    <!-- BANNER DESTACADO -->
                    <StackPane prefHeight="160.0"
                               style="-fx-background-color: #1E1A2E;
                                      -fx-background-radius: 16;
                                      -fx-border-color: rgba(86,74,181,0.3);
                                      -fx-border-radius: 16;
                                      -fx-padding: 28 30 28 30;
                                      -fx-effect: dropshadow(gaussian,rgba(86,74,181,0.15),30,0,0,10);">

                        <!-- Glow decorativo izquierda -->
                        <Circle radius="90" fill="#564AB5" opacity="0.06"
                                StackPane.alignment="CENTER_LEFT"/>

                        <HBox alignment="CENTER_LEFT" spacing="32">
                            <!-- Texto lado izquierdo -->
                            <VBox spacing="8" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
                                <Label text="🎵  NUEVA COLECCIÓN"
                                       style="-fx-font-size: 9px;
                                              -fx-text-fill: #BC7F15;
                                              -fx-font-weight: bold;
                                              -fx-letter-spacing: 2px;"/>
                                <Label text="Instrumentos para
cada nivel musical"
                                       style="-fx-font-size: 20px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #E9E9ED;
                                              -fx-line-spacing: 2;"/>
                                <Label text="Desde principiantes hasta profesionales"
                                       style="-fx-font-size: 12px;
                                              -fx-text-fill: #8F8AA8;"/>
                                <Button text="Ver Catálogo  →"
                                        mnemonicParsing="false"
                                        onAction="#navegarCatalogo"
                                        style="-fx-background-color: #BC7F15;
                                               -fx-background-radius: 8;
                                               -fx-text-fill: white;
                                               -fx-font-weight: bold;
                                               -fx-font-size: 12px;
                                               -fx-cursor: hand;
                                               -fx-padding: 8 20 8 20;
                                               -fx-effect: dropshadow(gaussian,rgba(188,127,21,0.3),14,0,0,4);"/>
                            </VBox>

                            <!-- ── TODO: IMG ── Banner principal
                                 Reemplazar el StackPane de abajo con:
                                 <ImageView fx:id="imgBanner"
                                            fitWidth="200" fitHeight="120"
                                            preserveRatio="true"/>
                                 y cargar en el controlador:
                                 imgBanner.setImage(new Image(getClass().getResourceAsStream("assets/banner.png")));
                            -->
                            <StackPane prefWidth="200.0" prefHeight="118.0"
                                       style="-fx-background-color: rgba(86,74,181,0.1);
                                              -fx-background-radius: 12;
                                              -fx-border-color: rgba(86,74,181,0.25);
                                              -fx-border-radius: 12;">
                                <VBox alignment="CENTER" spacing="6">
                                    <Label text="🎸" style="-fx-font-size: 48px;"/>
                                    <Label text="banner imagen aquí"
                                           style="-fx-font-size: 9px; -fx-text-fill: #8F8AA8;"/>
                                </VBox>
                            </StackPane>
                        </HBox>
                    </StackPane>

                    <!-- CATEGORÍAS RÁPIDAS -->
                    <VBox spacing="12">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Explorar categorías"
                                   style="-fx-font-size: 15px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #E9E9ED;"
                                   HBox.hgrow="ALWAYS"/>
                            <Button text="Ver todas →"
                                    mnemonicParsing="false"
                                    onAction="#navegarCatalogo"
                                    style="-fx-background-color: transparent;
                                           -fx-text-fill: #564AB5;
                                           -fx-font-size: 12px;
                                           -fx-cursor: hand;"/>
                        </HBox>
                        <!-- Pills de categorías  ─  fx:id para agregar dinámicamente -->
                        <HBox fx:id="categoriasBar" spacing="10">
                            <Button text="🎸  Guitarras" mnemonicParsing="false"
                                    style="-fx-background-color: rgba(86,74,181,0.18);
                                           -fx-background-radius: 20;
                                           -fx-border-color: #564AB5;
                                           -fx-border-radius: 20;
                                           -fx-text-fill: #A99CF0;
                                           -fx-font-size: 12px;
                                           -fx-cursor: hand;
                                           -fx-padding: 6 16 6 16;"/>
                            <Button text="🎹  Pianos" mnemonicParsing="false"
                                    style="-fx-background-color: #1E1A2E;
                                           -fx-background-radius: 20;
                                           -fx-border-color: rgba(86,74,181,0.25);
                                           -fx-border-radius: 20;
                                           -fx-text-fill: #8F8AA8;
                                           -fx-font-size: 12px;
                                           -fx-cursor: hand;
                                           -fx-padding: 6 16 6 16;"/>
                            <Button text="🥁  Percusión" mnemonicParsing="false"
                                    style="-fx-background-color: #1E1A2E;
                                           -fx-background-radius: 20;
                                           -fx-border-color: rgba(86,74,181,0.25);
                                           -fx-border-radius: 20;
                                           -fx-text-fill: #8F8AA8;
                                           -fx-font-size: 12px;
                                           -fx-cursor: hand;
                                           -fx-padding: 6 16 6 16;"/>
                            <Button text="🎻  Cuerdas" mnemonicParsing="false"
                                    style="-fx-background-color: #1E1A2E;
                                           -fx-background-radius: 20;
                                           -fx-border-color: rgba(86,74,181,0.25);
                                           -fx-border-radius: 20;
                                           -fx-text-fill: #8F8AA8;
                                           -fx-font-size: 12px;
                                           -fx-cursor: hand;
                                           -fx-padding: 6 16 6 16;"/>
                            <Button text="🎤  Voz" mnemonicParsing="false"
                                    style="-fx-background-color: #1E1A2E;
                                           -fx-background-radius: 20;
                                           -fx-border-color: rgba(86,74,181,0.25);
                                           -fx-border-radius: 20;
                                           -fx-text-fill: #8F8AA8;
                                           -fx-font-size: 12px;
                                           -fx-cursor: hand;
                                           -fx-padding: 6 16 6 16;"/>
                            <Button text="🎧  Accesorios" mnemonicParsing="false"
                                    style="-fx-background-color: #1E1A2E;
                                           -fx-background-radius: 20;
                                           -fx-border-color: rgba(86,74,181,0.25);
                                           -fx-border-radius: 20;
                                           -fx-text-fill: #8F8AA8;
                                           -fx-font-size: 12px;
                                           -fx-cursor: hand;
                                           -fx-padding: 6 16 6 16;"/>
                        </HBox>
                    </VBox>

                    <!-- PRODUCTOS DESTACADOS -->
                    <VBox spacing="14">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Productos Destacados"
                                   style="-fx-font-size: 15px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #E9E9ED;"
                                   HBox.hgrow="ALWAYS"/>
                            <Button text="Ver más →"
                                    mnemonicParsing="false"
                                    onAction="#navegarCatalogo"
                                    style="-fx-background-color: transparent;
                                           -fx-text-fill: #564AB5;
                                           -fx-font-size: 12px;
                                           -fx-cursor: hand;"/>
                        </HBox>
                        <!--
                            FlowPane  ─  las tarjetas se generan en el controlador
                            con agregarProductoCard(nombre, categoria, precio, emoji)
                            Para conectar con datos reales: llamar agregarProductoCard()
                            pasando objetos Producto desde el catálogo.
                        -->
                        <FlowPane fx:id="productosGrid"
                                  hgap="16" vgap="16"
                                  prefWrapLength="800"
                                  style="-fx-background-color: transparent;"/>
                    </VBox>
                </VBox>
            </ScrollPane>

            <!-- ─────────────────────────────────────────────
                 PANE: PERFIL
                 ───────────────────────────────────────────── -->
            <ScrollPane fx:id="panePerfil"
                        fitToWidth="true"
                        hbarPolicy="NEVER"
                        visible="false" managed="false"
                        style="-fx-background-color: transparent;
                               -fx-background: transparent;
                               -fx-border-color: transparent;">
                <VBox spacing="22"
                      style="-fx-padding: 28 32 36 32;
                             -fx-background-color: #151221;">

                    <!-- Encabezado sección -->
                    <Label text="Mi Perfil"
                           style="-fx-font-size: 22px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #E9E9ED;"/>

                    <!-- CARD AVATAR + INFO PRINCIPAL -->
                    <HBox alignment="CENTER_LEFT" spacing="24"
                          style="-fx-background-color: #1E1A2E;
                                 -fx-background-radius: 16;
                                 -fx-border-color: rgba(86,74,181,0.25);
                                 -fx-border-radius: 16;
                                 -fx-padding: 26 28 26 28;
                                 -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.4),20,0,0,6);">

                        <!-- ── TODO: IMG ── Avatar de usuario
                             El StackPane de abajo es el placeholder.
                             Para imagen real:
                             1. Agrega un ImageView con fx:id="imgAvatar" dentro del StackPane
                             2. En el controlador: imgAvatar.setImage(new Image(...))
                             3. Aplica clip circular: Circle clip = new Circle(45,45,45); imgAvatar.setClip(clip);
                             4. Esconde los Labels lblPerfilInitial y btnCambiarFoto si hay imagen.
                        -->
                        <StackPane prefWidth="90.0" prefHeight="90.0">
                            <Circle radius="45.0"
                                    fill="#272239"
                                    stroke="#564AB5" strokeWidth="2.0"/>
                            <Label fx:id="lblPerfilInitial" text="?"
                                   style="-fx-font-size: 30px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #564AB5;"/>
                            <!-- Botón cámara: esquina inferior derecha del avatar -->
                            <Button fx:id="btnCambiarFoto"
                                    text="📷"
                                    prefWidth="26.0" prefHeight="26.0"
                                    mnemonicParsing="false"
                                    onAction="#handleCambiarFoto"
                                    StackPane.alignment="BOTTOM_RIGHT"
                                    style="-fx-background-color: #BC7F15;
                                           -fx-background-radius: 13;
                                           -fx-font-size: 11px;
                                           -fx-cursor: hand;
                                           -fx-padding: 0;
                                           -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.4),6,0,0,2);"/>
                        </StackPane>

                        <!-- Nombre, email y badge de rol -->
                        <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
                            <Label fx:id="lblPerfilNombre"
                                   text="Nombre Usuario"
                                   style="-fx-font-size: 20px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #E9E9ED;"/>
                            <Label fx:id="lblPerfilEmail"
                                   text="email@harmonia.com"
                                   style="-fx-font-size: 12px;
                                          -fx-text-fill: #8F8AA8;"/>
                            <!-- Badge de rol -->
                            <HBox>
                                <Label fx:id="lblRolBadge" text="ROL"
                                       style="-fx-background-color: rgba(188,127,21,0.18);
                                              -fx-background-radius: 6;
                                              -fx-border-color: rgba(188,127,21,0.4);
                                              -fx-border-radius: 6;
                                              -fx-text-fill: #BC7F15;
                                              -fx-font-size: 10px;
                                              -fx-font-weight: bold;
                                              -fx-padding: 3 10 3 10;"/>
                            </HBox>
                        </VBox>

                        <!-- Botón editar (derecha) -->
                        <Button fx:id="btnEditarPerfil"
                                text="✏   Editar"
                                mnemonicParsing="false"
                                onAction="#handleEditarPerfil"
                                style="-fx-background-color: transparent;
                                       -fx-background-radius: 8;
                                       -fx-border-color: rgba(86,74,181,0.5);
                                       -fx-border-radius: 8;
                                       -fx-text-fill: #A99CF0;
                                       -fx-font-size: 12px;
                                       -fx-cursor: hand;
                                       -fx-padding: 8 18 8 18;"/>
                    </HBox>

                    <!-- FILA DE CARDS INFORMATIVAS -->
                    <HBox spacing="16">

                        <!-- Card: Tipo de perfil -->
                        <VBox spacing="6" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: #1E1A2E;
                                     -fx-background-radius: 12;
                                     -fx-border-color: rgba(86,74,181,0.2);
                                     -fx-border-radius: 12;
                                     -fx-padding: 18 20 18 20;">
                            <Label text="Tipo de Perfil"
                                   style="-fx-font-size: 10px;
                                          -fx-text-fill: #8F8AA8;
                                          -fx-font-weight: bold;"/>
                            <Label fx:id="lblTipoPerfil" text="—"
                                   style="-fx-font-size: 16px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #564AB5;"/>
                        </VBox>

                        <!-- Card: Instrumento principal -->
                        <VBox spacing="6" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: #1E1A2E;
                                     -fx-background-radius: 12;
                                     -fx-border-color: rgba(86,74,181,0.2);
                                     -fx-border-radius: 12;
                                     -fx-padding: 18 20 18 20;">
                            <Label text="Instrumento Principal"
                                   style="-fx-font-size: 10px;
                                          -fx-text-fill: #8F8AA8;
                                          -fx-font-weight: bold;"/>
                            <Label fx:id="lblInstrumento" text="—"
                                   style="-fx-font-size: 16px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #E9E9ED;"/>
                        </VBox>

                        <!-- Card: Presupuesto -->
                        <VBox spacing="6" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: #1E1A2E;
                                     -fx-background-radius: 12;
                                     -fx-border-color: rgba(86,74,181,0.2);
                                     -fx-border-radius: 12;
                                     -fx-padding: 18 20 18 20;">
                            <Label text="Presupuesto"
                                   style="-fx-font-size: 10px;
                                          -fx-text-fill: #8F8AA8;
                                          -fx-font-weight: bold;"/>
                            <Label fx:id="lblPresupuesto" text="—"
                                   style="-fx-font-size: 16px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #BC7F15;"/>
                        </VBox>
                    </HBox>

                    <!-- FORMULARIO DE EDICIÓN  ─  oculto por defecto
                         Se muestra con handleEditarPerfil()
                         Extensible: agrega más TextField aquí (instrumento_2, género, etc.)
                    -->
                    <VBox fx:id="seccionEditar"
                          spacing="16"
                          visible="false" managed="false"
                          style="-fx-background-color: #1E1A2E;
                                 -fx-background-radius: 14;
                                 -fx-border-color: rgba(86,74,181,0.3);
                                 -fx-border-radius: 14;
                                 -fx-padding: 22 24 22 24;">

                        <Label text="Editar Información"
