                                       promptText="Ej: 1500"
                                       prefHeight="38.0"
                                       style="-fx-background-color: #272239;
                                              -fx-background-radius: 8;
                                              -fx-border-color: rgba(86,74,181,0.3);
                                              -fx-border-radius: 8;
                                              -fx-text-fill: #E9E9ED;
                                              -fx-prompt-text-fill: #8F8AA8;
                                              -fx-font-size: 13px;"/>
                        </VBox>

                        <!--
                            TODO: Tipo de perfil  (ComboBox)
                            Descomentar cuando TipoPerfil sea accesible en el controlador:

                            <VBox spacing="6">
                                <Label text="Tipo de Perfil" style="..."/>
                                <ComboBox fx:id="cmbTipoPerfil" prefHeight="38" maxWidth="Infinity"
                                          style="..."/>
                            </VBox>
                        -->

                        <!-- Botón Guardar -->
                        <Button fx:id="btnGuardarPerfil"
                                text="💾   Guardar Cambios"
                                maxWidth="Infinity"
                                prefHeight="42.0"
                                mnemonicParsing="false"
                                onAction="#handleGuardarPerfil"
                                style="-fx-background-color: #564AB5;
                                       -fx-background-radius: 8;
                                       -fx-text-fill: white;
                                       -fx-font-weight: bold;
                                       -fx-font-size: 13px;
                                       -fx-cursor: hand;
                                       -fx-effect: dropshadow(gaussian,rgba(86,74,181,0.3),16,0,0,6);"/>

                        <!-- Feedback message -->
                        <Label fx:id="lblPerfilFeedback" text=""
                               prefWidth="1e30"
                               style="-fx-font-size: 12px; -fx-text-alignment: center;"
                               wrapText="true"/>
                    </VBox>

                    <!-- ZONA DE PELIGRO -->
                    <VBox spacing="12"
                          style="-fx-background-color: rgba(255,107,107,0.05);
                                 -fx-background-radius: 12;
                                 -fx-border-color: rgba(255,107,107,0.2);
                                 -fx-border-radius: 12;
                                 -fx-padding: 18 20 18 20;">
                        <Label text="Zona de peligro"
                               style="-fx-font-size: 12px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #FF6B6B;"/>
                        <Label text="Estas acciones son irreversibles. Procede con cuidado."
                               style="-fx-font-size: 11px;
                                      -fx-text-fill: #8F8AA8;"/>
                        <Button fx:id="btnCerrarSesion"
                                text="⇠  Cerrar Sesión"
                                mnemonicParsing="false"
                                onAction="#handleLogout"
                                style="-fx-background-color: rgba(255,107,107,0.15);
                                       -fx-background-radius: 8;
                                       -fx-border-color: rgba(255,107,107,0.35);
                                       -fx-border-radius: 8;
                                       -fx-text-fill: #FF6B6B;
                                       -fx-font-size: 12px;
                                       -fx-font-weight: bold;
                                       -fx-cursor: hand;
                                       -fx-padding: 8 20 8 20;"/>
                    </VBox>

                </VBox>
