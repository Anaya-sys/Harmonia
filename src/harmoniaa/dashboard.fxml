                                      -fx-font-weight: bold;
                                      -fx-text-fill: #E9E9ED;"/>

                        <Separator style="-fx-background-color: rgba(86,74,181,0.15);"/>

                        <!-- Nombre -->
                        <VBox spacing="6">
                            <Label text="Nombre Completo"
                                   style="-fx-font-size: 11px;
                                          -fx-text-fill: #8F8AA8;"/>
                            <TextField fx:id="txtEditNombre"
                                       promptText="Tu nombre completo"
                                       prefHeight="38.0"
                                       style="-fx-background-color: #272239;
                                              -fx-background-radius: 8;
                                              -fx-border-color: rgba(86,74,181,0.3);
                                              -fx-border-radius: 8;
                                              -fx-text-fill: #E9E9ED;
                                              -fx-prompt-text-fill: #8F8AA8;
                                              -fx-font-size: 13px;"/>
                        </VBox>

