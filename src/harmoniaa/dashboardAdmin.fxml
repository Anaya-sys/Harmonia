<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<!--
    ══════════════════════════════════════════════════════════════════════
    dashboardAdmin.fxml  ·  Panel de Administración — Harmonia
    Controlador: harmoniaa.DashboardAdminController

    MEJORAS DE DISEÑO APLICADAS (DSG-01 → DSG-28)
    ──────────────────────────────────────────────
    DSG-01  Fondo: radial-gradient profundo en BorderPane + VBox backgrounds → #0E0C18
    DSG-02  Ambient glow violeta en contentArea (Region no interactiva)
    DSG-03  Sidebar: gradiente vertical en FXML
    DSG-04  Nav activo: línea izquierda + fondo degradado (aplicado en Java)
    DSG-05  Logo box: borde inferior + padding mejorado
    DSG-06  Admin badge: letter-spacing + tono dorado saturado
    DSG-07  userInfoBox: fondo ultra-suave + borde superior
    DSG-08  Header: accent bar izquierda (Region 4px con gradiente violeta-dorado)
    DSG-09  Header: fondo sutil + borde inferior
    DSG-10  Content area: separador visual aplicado en el CSS
    DSG-11  Stat cards: gradiente 135°, border-radius 18, sombra profunda
    DSG-12  Icon chips: borde + fondo tintado por color de card
    DSG-13  Hint con flecha de tendencia
    DSG-14  Stat numbers: 32px unificado; category labels 10px + letter-spacing
    DSG-15  Cola de Pendientes header: gradiente dorado → transparent
    DSG-16  Acciones Rápidas: btn primario gradiente, secundarios padding unificado 13px
    DSG-17  Filter tabs: pill style (border-radius 20)
    DSG-18  Pedido card: 3 zonas (aplicado en Java)
    DSG-19  Buscador: cápsula border-radius 21, 260×42
    DSG-20  Perfil card: gradiente 3 colores + sombra dorada
    DSG-21  Avatar perfil: gradient ring dorado-violeta
    DSG-22  Perfil: mini-barras de progreso (aplicado en Java)
    DSG-23  Logout: borde visible + texto "→  Cerrar sesión"
    DSG-24  Transiciones fade entre panes (aplicado en Java)
    DSG-25  Stat cards stagger scale (aplicado en Java)
    DSG-26  Toast flotante overlay con slide-up (aplicado en Java)
    DSG-27  Font-family refinada en .root CSS
    DSG-28  Letter-spacing en títulos de sección (aplicado en Java)
    ══════════════════════════════════════════════════════════════════════
-->

<!-- DSG-01: radial-gradient en el BorderPane raíz -->
<BorderPane
    fx:controller="harmoniaa.DashboardAdminController"
    prefHeight="720.0" prefWidth="1280.0"
    minHeight="620.0" minWidth="920.0"
    style="-fx-background-color:
           radial-gradient(center 30% 20%, radius 60%,
           #1A1535 0%, #0E0C18 100%);"
    stylesheets="@dashboard.css"
    xmlns="http://javafx.com/javafx/26"
    xmlns:fx="http://javafx.com/fxml/1">

    <!-- ══════════════════════════════════════════════════════
         SIDEBAR  ·  Colapsable: 68 px → 230 px
         DSG-03: gradiente vertical  DSG-04: nav activo aplicado en Java
         ══════════════════════════════════════════════════════ -->
    <left>
        <VBox fx:id="sidebar"
      prefWidth="68.0"
      onMouseEntered="#handleSidebarEntered"
      onMouseExited="#handleSidebarExited"
      style="-fx-background-color: linear-gradient(from 0% 0% to 0% 100%, #1A1630 0%, #110F22 100%);
             -fx-border-color: rgba(120,100,220,0.18);
             -fx-border-width: 0 1 0 0;">

            <!-- ── LOGO — DSG-05: borde inferior sutil + padding superior ── -->
            <HBox fx:id="logoBox" alignment="CENTER"
                  style="-fx-padding: 24 16 20 16;
                         -fx-background-color: transparent;
                         -fx-border-color: transparent transparent rgba(120,100,220,0.15) transparent;
                         -fx-border-width: 0 0 1 0;">
                <ImageView fx:id="logoIcono"
                           fitWidth="38.0" fitHeight="38.0"
                           preserveRatio="true" pickOnBounds="true">
                    <image><Image url="@logoicono.png"/></image>
                </ImageView>
                <ImageView fx:id="logoCompleto"
                           fitWidth="150.0" fitHeight="44.0"
                           preserveRatio="true" pickOnBounds="true"
                           visible="false" managed="false">
                    <image><Image url="@logo.png"/></image>
                </ImageView>
            </HBox>

            <!-- ── BADGE ADMIN — DSG-06: letter-spacing + tono dorado saturado ── -->
            <HBox fx:id="adminBadgeBox" alignment="CENTER"
                  visible="false" managed="false"
                  style="-fx-padding: 8 16 8 16;
                         -fx-background-color: rgba(212,160,23,0.06);
                         -fx-border-color: rgba(212,160,23,0.20);
                         -fx-border-width: 1 0 1 0;">
                <Label text="⚙  PANEL DE ADMINISTRACIÓN"
                       style="-fx-font-size: 9px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #D4A017;"/>
            </HBox>

            <!-- DSG-28: separador con clase CSS -->
            <Separator styleClass="separador-sutil"/>

            <!-- ── NAV ITEMS ── -->
            <VBox fx:id="navContainer" spacing="6"
                  style="-fx-padding: 14 8 14 8;"
                  VBox.vgrow="ALWAYS">

                <!-- Dashboard / Overview — activo por defecto -->
                <Button fx:id="navBtnDashboard"
                        text="📊"
                        maxWidth="99999"
                        alignment="CENTER_LEFT"
                        prefHeight="50.0"
                        mnemonicParsing="false"
                        onAction="#navegarDashboard"
                        style="-fx-border-color: transparent transparent transparent #6C5CE7;
                              -fx-border-width: 0 0 0 3;
                              -fx-background-color: linear-gradient(from 0% 0% to 100% 0%, rgba(108,92,231,0.25), rgba(108,92,231,0.08));
                              -fx-background-radius: 0 10 10 0;
                              -fx-text-fill: white;
                              -fx-font-size: 15px;
                              -fx-font-weight: bold;
                              -fx-cursor: hand;
                              -fx-padding: 0 12 0 14;"/>

                <!-- Pedidos -->
                <Button fx:id="navBtnPedidos"
                        text="📦"
                        maxWidth="99999"
                        alignment="CENTER_LEFT"
                        prefHeight="50.0"
                        mnemonicParsing="false"
                        onAction="#navegarPedidosAdmin"
                        style="-fx-background-color: transparent;
                               -fx-background-radius: 10;
                               -fx-text-fill: #8B88A8;
                               -fx-font-size: 15px;
                               -fx-cursor: hand;
                               -fx-padding: 0 12 0 14;"/>

                <!-- Catálogo -->
                <Button fx:id="navBtnCatalogo"
                        text="🏷️"
                        maxWidth="99999"
                        alignment="CENTER_LEFT"
                        prefHeight="50.0"
                        mnemonicParsing="false"
                        onAction="#navegarCatalogoAdmin"
                        style="-fx-background-color: transparent;
                               -fx-background-radius: 10;
                               -fx-text-fill: #8B88A8;
                               -fx-font-size: 15px;
                               -fx-cursor: hand;
                               -fx-padding: 0 12 0 14;"/>

                <!-- Usuarios -->
                <Button fx:id="navBtnUsuarios"
                        text="👥"
                        maxWidth="99999"
                        alignment="CENTER_LEFT"
                        prefHeight="50.0"
                        mnemonicParsing="false"
                        onAction="#navegarUsuariosAdmin"
                        style="-fx-background-color: transparent;
                               -fx-background-radius: 10;
                               -fx-text-fill: #8B88A8;
                               -fx-font-size: 15px;
                               -fx-cursor: hand;
                               -fx-padding: 0 12 0 14;"/>

                <!-- Perfil del admin -->
                <Button fx:id="navBtnPerfil"
                        text="👤"
                        maxWidth="99999"
                        alignment="CENTER_LEFT"
                        prefHeight="50.0"
                        mnemonicParsing="false"
                        onAction="#navegarPerfilAdmin"
                        style="-fx-background-color: transparent;
                               -fx-background-radius: 10;
                               -fx-text-fill: #8B88A8;
                               -fx-font-size: 15px;
                               -fx-cursor: hand;
                               -fx-padding: 0 12 0 14;"/>

            </VBox>

            <!-- ── INFO USUARIO (bottom) — DSG-07: fondo ultrasuave ── -->
            <HBox fx:id="userInfoBox" alignment="CENTER_LEFT" spacing="10"
                  style="-fx-padding: 14 10 20 12;
                         -fx-border-color: rgba(120,100,220,0.20) transparent transparent transparent;
                         -fx-border-width: 1 0 0 0;
                         -fx-background-color: rgba(108,92,231,0.03);">

                <StackPane prefWidth="42.0" prefHeight="42.0">
                    <Circle radius="21.0" fill="#272239"
                            stroke="#D4A017" strokeWidth="2.0"/>
                    <Label fx:id="lblAvatarInitial" text="A"
                           style="-fx-font-size: 16px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #D4A017;"/>
                </StackPane>

                <VBox fx:id="userTextBox" spacing="2"
                      HBox.hgrow="ALWAYS"
                      visible="false" managed="false">
                    <Label fx:id="lblSidebarNombre" text="Admin"
                           style="-fx-font-size: 13px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #F0EEF8;"/>
                    <Label fx:id="lblSidebarRol" text="ADMINISTRADOR"
                           style="-fx-font-size: 10px;
                                  -fx-text-fill: #D4A017;
                                  -fx-font-weight: bold;"/>
                </VBox>

                <!-- DSG-23: botón logout con borde visible -->
                <Button fx:id="btnLogout"
                        text="→"
                        prefWidth="34.0" prefHeight="34.0"
                        mnemonicParsing="false"
                        onAction="#handleLogout"
                        visible="false" managed="false"
                        styleClass="btn-logout"/>
            </HBox>
        </VBox>
    </left>

    <!-- ══════════════════════════════════════════════════════
         ÁREA CENTRAL  ·  StackPane dinámico
         DSG-01: fondo profundo
         ══════════════════════════════════════════════════════ -->
    <center>
        <StackPane fx:id="contentArea"
                   style="-fx-background-color: #0E0C18;">

            <!-- DSG-02: Ambient glow violeta — primer hijo, detrás de todo -->
            <Region mouseTransparent="true"
                    style="-fx-background-color:
                            radial-gradient(center 15% 10%, radius 40%,
                            rgba(108,92,231,0.06) 0%, transparent 70%);
                           -fx-min-height: 720; -fx-max-height: 99999;"/>

            <!-- ═══════════════════════════════════════════════
                 PANE 1: OVERVIEW / DASHBOARD (visible por defecto)
                 ═══════════════════════════════════════════════ -->
            <ScrollPane fx:id="paneOverview"
                        fitToWidth="true"
                        hbarPolicy="NEVER"
                        style="-fx-background-color: transparent;
                               -fx-background: transparent;
                               -fx-border-color: transparent;">
                <!-- DSG-01: fondo consistente con la raíz -->
                <VBox spacing="0"
                      style="-fx-background-color: #0E0C18;">

                    <!-- ── HEADER — DSG-08 accent bar + DSG-09 fondo sutil ── -->
                    <HBox alignment="CENTER_LEFT" spacing="16"
                          style="-fx-padding: 28 32 22 32;
                                 -fx-background-color: rgba(108,92,231,0.04);
                                 -fx-border-color: transparent transparent rgba(120,100,220,0.12) transparent;
                                 -fx-border-width: 0 0 1 0;">
                        <!-- DSG-08: accent bar izquierda violeta→dorado -->
                        <HBox alignment="CENTER_LEFT" spacing="12" HBox.hgrow="ALWAYS">
                            <Region prefWidth="4" prefHeight="36"
                                style="-fx-background-color: linear-gradient(from 0% 0% to 0% 100%, #6C5CE7, #D4A017);
                                       -fx-background-radius: 2;"/>
                            <VBox spacing="4">
                                <Label text="Panel de Administración"
                                       style="-fx-font-size: 26px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #F0EEF8;"/>
                                <Label fx:id="lblSubtituloDashboard"
                                       text="Resumen general del sistema"
                                       style="-fx-font-size: 13px;
                                              -fx-text-fill: #8B88A8;"/>
                            </VBox>
                        </HBox>
                        <!-- Botón Refrescar — DSG-09 estilo btn-refrescar -->
                        <Button fx:id="btnRefrescarOverview"
                                text="↻  Actualizar"
                                mnemonicParsing="false"
                                onAction="#handleRefrescar"
                                styleClass="btn-refrescar"/>
                        <!-- Procesar siguiente — btn-primario -->
                        <Button fx:id="btnProcesarSiguienteOv"
                                text="⚡  Procesar siguiente"
                                mnemonicParsing="false"
                                onAction="#handleProcesarSiguiente"
                                styleClass="btn-primario"/>
                    </HBox>

                    <!-- ── STAT CARDS — DSG-11/12/13/14 ── -->
                    <HBox spacing="18"
                          style="-fx-padding: 28 32 0 32;">

                        <!-- Card: Total Pedidos -->
                        <VBox spacing="10" HBox.hgrow="ALWAYS"
                             style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #1C1930 0%, #141228 100%);
                                    -fx-background-radius: 18;
                                    -fx-border-color: rgba(120,100,220,0.22);
                                    -fx-border-radius: 18;
                                    -fx-border-width: 1;
                                    -fx-padding: 24 26 24 26;
                                    -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.55), 28, 0, 0, 10);">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <!-- DSG-12: icon chip violeta con borde -->
                                <Label text="📦"
                                       style="-fx-font-size: 20px;
                                              -fx-background-color: rgba(108,92,231,0.18);
                                              -fx-background-radius: 12;
                                              -fx-border-color: rgba(108,92,231,0.25);
                                              -fx-border-radius: 12;
                                              -fx-border-width: 1;
                                              -fx-padding: 10 12 10 12;"/>
                                <VBox spacing="2" HBox.hgrow="ALWAYS">
                                    <!-- DSG-14: label 10px + letter-spacing -->
                                    <Label text="TOTAL PEDIDOS"
                                           style="-fx-font-size: 10px;
                                                  -fx-text-fill: #8B88A8;
                                                  -fx-font-weight: bold;"/>
                                    <!-- DSG-14: número unificado 32px -->
                                    <Label fx:id="lblTotalPedidos" text="0"
                                           style="-fx-font-size: 32px;
                                                  -fx-font-weight: bold;
                                                  -fx-text-fill: #F0EEF8;"/>
                                </VBox>
                            </HBox>
                            <!-- DSG-13: hint con flecha de tendencia -->
                            <Label fx:id="lblTotalPedidosHint"
                                   text="↑  pedidos registrados"
                                   style="-fx-font-size: 11px; -fx-text-fill: #6C5CE7;"/>
                        </VBox>

                        <!-- Card: En Cola (Pendientes) -->
                        <VBox spacing="10" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #1C1930 0%, #141228 100%);
                                     -fx-background-radius: 18;
                                     -fx-border-color: rgba(120,100,220,0.22);
                                     -fx-border-radius: 18;
                                     -fx-border-width: 1;
                                     -fx-padding: 24 26 24 26;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.55), 28, 0, 0, 10);">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <!-- DSG-12: icon chip dorado -->
                                <Label text="⏳"
                                       style="-fx-font-size: 20px;
                                              -fx-background-color: rgba(212,160,23,0.18);
                                              -fx-background-radius: 12;
                                              -fx-border-color: rgba(212,160,23,0.28);
                                              -fx-border-radius: 12;
                                              -fx-border-width: 1;
                                              -fx-padding: 10 12 10 12;"/>
                                <VBox spacing="2" HBox.hgrow="ALWAYS">
                                    <Label text="EN COLA"
                                           style="-fx-font-size: 10px;
                                                  -fx-text-fill: #8B88A8;
                                                  -fx-font-weight: bold;"/>
                                    <Label fx:id="lblEnCola" text="0"
                                           style="-fx-font-size: 32px;
                                                  -fx-font-weight: bold;
                                                  -fx-text-fill: #F0EEF8;"/>
                                </VBox>
                            </HBox>
                            <Label fx:id="lblEnColaHint"
                                   text="↑  pendientes de procesar"
                                   style="-fx-font-size: 11px; -fx-text-fill: #D4A017;"/>
                        </VBox>

                        <!-- Card: Ingresos — DSG-12: icon chip verde -->
                        <VBox spacing="10" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #1C1930 0%, #141228 100%);
                                     -fx-background-radius: 18;
                                     -fx-border-color: rgba(120,100,220,0.22);
                                     -fx-border-radius: 18;
                                     -fx-border-width: 1;
                                     -fx-padding: 24 26 24 26;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.55), 28, 0, 0, 10);">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="💰"
                                       style="-fx-font-size: 20px;
                                              -fx-background-color: rgba(0,201,167,0.15);
                                              -fx-background-radius: 12;
                                              -fx-border-color: rgba(0,201,167,0.22);
                                              -fx-border-radius: 12;
                                              -fx-border-width: 1;
                                              -fx-padding: 10 12 10 12;"/>
                                <VBox spacing="2" HBox.hgrow="ALWAYS">
                                    <Label text="INGRESOS TOTALES"
                                           style="-fx-font-size: 10px;
                                                  -fx-text-fill: #8B88A8;
                                                  -fx-font-weight: bold;"/>
                                    <!-- DSG-14: 32px unificado -->
                                    <Label fx:id="lblIngresos" text="\$0"
                                           style="-fx-font-size: 32px;
                                                  -fx-font-weight: bold;
                                                  -fx-text-fill: #F0EEF8;"/>
                                </VBox>
                            </HBox>
                            <Label fx:id="lblIngresosHint"
                                   text="↑  suma de todos los pedidos"
                                   style="-fx-font-size: 11px; -fx-text-fill: #00C9A7;"/>
                        </VBox>

                        <!-- Card: Entregados — DSG-12: icon chip azul -->
                        <VBox spacing="10" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #1C1930 0%, #141228 100%);
                                     -fx-background-radius: 18;
                                     -fx-border-color: rgba(120,100,220,0.22);
                                     -fx-border-radius: 18;
                                     -fx-border-width: 1;
                                     -fx-padding: 24 26 24 26;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.55), 28, 0, 0, 10);">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="✅"
                                       style="-fx-font-size: 20px;
                                              -fx-background-color: rgba(78,154,241,0.15);
                                              -fx-background-radius: 12;
                                              -fx-border-color: rgba(78,154,241,0.22);
                                              -fx-border-radius: 12;
                                              -fx-border-width: 1;
                                              -fx-padding: 10 12 10 12;"/>
                                <VBox spacing="2" HBox.hgrow="ALWAYS">
                                    <Label text="ENTREGADOS"
                                           style="-fx-font-size: 10px;
                                                  -fx-text-fill: #8B88A8;
                                                  -fx-font-weight: bold;"/>
                                    <Label fx:id="lblEntregados" text="0"
                                           style="-fx-font-size: 32px;
                                                  -fx-font-weight: bold;
                                                  -fx-text-fill: #F0EEF8;"/>
                                </VBox>
                            </HBox>
                            <Label fx:id="lblEntregadosHint"
                                   text="↑  pedidos completados"
                                   style="-fx-font-size: 11px; -fx-text-fill: #4E9AF1;"/>
                        </VBox>

                    </HBox>

                    <!-- ── DOS COLUMNAS: COLA + ACCIONES ── -->
                    <HBox spacing="18"
                          style="-fx-padding: 22 32 0 32;"
                          alignment="TOP_LEFT">

                        <!-- Cola de Pendientes — DSG-15 header con gradiente dorado -->
                        <VBox spacing="0" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #1C1930 0%, #141228 100%);
                                     -fx-background-radius: 14;
                                     -fx-border-color: rgba(212,160,23,0.22);
                                     -fx-border-radius: 14;
                                     -fx-border-width: 1;">

                            <!-- DSG-15: header con gradiente dorado desvanecido -->
                            <HBox alignment="CENTER_LEFT" spacing="10"
                                 style="-fx-padding: 18 20 16 20;
                                        -fx-background-color: linear-gradient(from 0% 0% to 100% 0%, rgba(212,160,23,0.08), transparent);
                                        -fx-border-color: transparent transparent rgba(212,160,23,0.15) transparent;
                                        -fx-border-width: 0 0 1 0;
                                        -fx-background-radius: 14 14 0 0;">
                                <Label text="⏳  Cola de Pendientes"
                                       style="-fx-font-size: 15px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #E8E6F8;"
                                       HBox.hgrow="ALWAYS"/>
                                <Label fx:id="lblColaBadge" text="0"
                                       style="-fx-background-color: rgba(212,160,23,0.20);
                                              -fx-background-radius: 12;
                                              -fx-text-fill: #D4A017;
                                              -fx-font-size: 11px;
                                              -fx-font-weight: bold;
                                              -fx-padding: 3 10 3 10;"/>
                            </HBox>

                            <!-- Contenedor dinámico de la cola -->
                            <VBox fx:id="colaContainer" spacing="0"
                                  style="-fx-padding: 10 0 10 0;
                                         -fx-min-height: 80;"/>

                        </VBox>

                        <!-- Acciones Rápidas — DSG-16: botones con padding unificado 13px -->
                        <VBox spacing="12" prefWidth="280.0"
                              style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #1C1930 0%, #141228 100%);
                                     -fx-background-radius: 14;
                                     -fx-border-color: rgba(108,92,231,0.20);
                                     -fx-border-radius: 14;
                                     -fx-border-width: 1;
                                     -fx-padding: 18 20 20 20;">

                            <Label text="⚡  Acciones Rápidas"
                                   style="-fx-font-size: 15px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #E8E6F8;
                                          -fx-padding: 0 0 8 0;
                                          -fx-border-color: rgba(108,92,231,0.12);
                                          -fx-border-width: 0 0 1 0;"/>

                            <!-- DSG-16: btn primario gradiente dorado -->
                            <Button text="⚡  Procesar Siguiente (FIFO)"
                                    maxWidth="99999"
                                    mnemonicParsing="false"
                                    onAction="#handleProcesarSiguiente"
                                    prefHeight="44.0"
                                    styleClass="btn-primario"/>

                            <!-- DSG-16: botones secundarios padding 13px unificado -->
                            <Button text="📦  Ver todos los pedidos"
                                    maxWidth="99999"
                                    mnemonicParsing="false"
                                    onAction="#navegarPedidosAdmin"
                                    prefHeight="44.0"
                                    styleClass="btn-secundario"/>

                            <Button text="🔍  Pedidos pendientes"
                                    maxWidth="99999"
                                    mnemonicParsing="false"
                                    onAction="#irAPedidosPendientes"
                                    prefHeight="44.0"
                                    style="-fx-background-color: transparent;
                                           -fx-background-radius: 10;
                                           -fx-border-color: rgba(212,160,23,0.30);
                                           -fx-border-radius: 10;
                                           -fx-border-width: 1;
                                           -fx-text-fill: #D4A017;
                                           -fx-font-size: 13px;
                                           -fx-cursor: hand;
                                           -fx-padding: 13 0 13 0;"/>

                            <Separator styleClass="separador-sutil"/>

